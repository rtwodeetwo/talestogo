# =============================================================================
# Tales Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.template .env
#
# Every variable here is read by docker-compose.yml. Full reference:
#   docs/ENV_VARS_REFERENCE.md
# Deployment walkthrough:
#   docs/IT_DEPLOYMENT_GUIDE.md
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED: Security Keys
# -----------------------------------------------------------------------------

# Secret used to sign JWTs.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET=CHANGE_ME_generate_a_random_key

# Fernet key used to encrypt stored API keys.
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=CHANGE_ME_generate_a_fernet_key

# Password for the bundled PostgreSQL container. Change this for any
# deployment that is not a throwaway local test.
DB_PASSWORD=tales_password

# -----------------------------------------------------------------------------
# REQUIRED: LLM API Keys (at least ONE)
# -----------------------------------------------------------------------------
# Tales is provider-agnostic. Set the key for whichever providers you have,
# then go to Admin > LLM Providers after first login to enable them. The
# provider flagged use_for_analysis=True handles response analysis and brand
# auto-generation.
#
# The "State of the LLMs" report section needs a provider with web search
# (Gemini or Perplexity). If neither is configured, that one section is
# omitted and everything else works normally.

# Google Gemini (supports web search) - https://ai.google.dev/
GEMINI_API_KEY=

# OpenAI ChatGPT - https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic Claude - https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Perplexity (supports web search) - https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=

# Azure OpenAI. This holds the API key only. The resource URL, api_version,
# and deployment name are tenant-specific and are configured per-provider in
# Admin > LLM Providers.
# Get it from: Azure Portal > your OpenAI resource > Keys
AZURE_OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# OPTIONAL: Web search for the "State of the LLMs" report section
# -----------------------------------------------------------------------------
# Only needed if you want that section AND your deployment does not already
# have Gemini or Perplexity configured.

# Bing Search v7 (Microsoft REST API). Retrieves search results; synthesis is
# done by whichever provider you flag use_for_analysis=True. The endpoint is
# configured in the Admin UI.
BING_SEARCH_V7_API_KEY=

# Azure AI Foundry "Grounding with Bing Search", for a fully Azure-native
# deployment. Auth is via DefaultAzureCredential, so no API key is needed.
# Requires: pip install .[azure-foundry]
AZURE_AI_PROJECT_ENDPOINT=
AZURE_AI_BING_CONNECTION_NAME=

# -----------------------------------------------------------------------------
# Authentication Method Flags
# -----------------------------------------------------------------------------
# The login page shows only the methods that are both enabled and configured.
# Email/password works immediately. The OAuth methods also need a client ID.

ENABLE_LOCAL_AUTH=true
ENABLE_MICROSOFT_AUTH=true
ENABLE_GOOGLE_AUTH=false

# -----------------------------------------------------------------------------
# OPTIONAL: Microsoft Entra ID (OIDC)
# -----------------------------------------------------------------------------
# Only needed when ENABLE_MICROSOFT_AUTH=true. No client secret is required:
# the app uses MSAL's client-side PKCE flow. IT provides the client ID during
# app registration.

OIDC_CLIENT_ID=

# Optional, for single-tenant setups. Defaults to the common endpoint:
#   https://login.microsoftonline.com/common/v2.0/.well-known/openid-configuration
# OIDC_DISCOVERY_URL=https://login.microsoftonline.com/{tenant-id}/v2.0/.well-known/openid-configuration

# OAuth flow type: "popup" (default) or "redirect".
# Popup mode: register https://<your-domain> as the redirect URI.
# Redirect mode: register https://<your-domain>/login as the redirect URI.
# Google always uses popup.
# AUTH_FLOW_TYPE=popup

# Skip the login page and go straight to Microsoft. Only takes effect when ALL
# of: AUTH_FLOW_TYPE=redirect, ENABLE_MICROSOFT_AUTH=true,
# ENABLE_LOCAL_AUTH=false, ENABLE_GOOGLE_AUTH=false.
# AUTO_LOGIN_MICROSOFT=false

# -----------------------------------------------------------------------------
# OPTIONAL: Google OAuth
# -----------------------------------------------------------------------------
# Only needed when ENABLE_GOOGLE_AUTH=true. No client secret is required.

GOOGLE_CLIENT_ID=

# -----------------------------------------------------------------------------
# Branding
# -----------------------------------------------------------------------------

# Site name displayed throughout the UI
SITE_NAME=Tales

# URL to your organization's logo (optional)
# SITE_LOGO_URL=https://your-org.gov/logo.png

# Theme colors (hex)
SITE_PRIMARY_COLOR=#003e60
SITE_SECONDARY_COLOR=#75c9c8

# -----------------------------------------------------------------------------
# OPTIONAL: Email (for sending user invitations)
# -----------------------------------------------------------------------------

# Resend API - https://resend.com
RESEND_API_KEY=
FROM_EMAIL=admin@yourdomain.gov

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------

# Used for CORS and for links in outgoing email. Set this to the URL users
# actually reach Tales at.
FRONTEND_URL=http://localhost:8080

# Host port mapping. Change if 8080 is already in use.
APP_PORT=8080

ENVIRONMENT=production

# Automated data collection and report generation
ENABLE_SCHEDULER=true

# Backend API URL baked into the frontend at build time. Only change this if
# you serve the frontend separately from the backend.
# VITE_API_URL=http://localhost:8080

# -----------------------------------------------------------------------------
# OPTIONAL: Investigations
# -----------------------------------------------------------------------------
# Auto-triggered investigations are on by default. Set the trigger to false to
# run investigations only when someone asks for one from the UI. That is worth
# doing around a data import or a change in collection method, when a large
# movement is expected and already understood.
#
# Thresholds are absolute percentage points of movement.

INVESTIGATIONS_AUTO_TRIGGER=true
INVESTIGATION_THRESHOLD_MENTION_RATE=10.0
INVESTIGATION_THRESHOLD_POSITIVE_SENTIMENT_RATE=15.0
INVESTIGATION_THRESHOLD_LEADERSHIP_VISIBILITY=15.0
INVESTIGATION_THRESHOLD_SHARE_OF_VOICE=10.0
